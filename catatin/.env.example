# =============================================================================
# CATATIN — contoh konfigurasi environment
# -----------------------------------------------------------------------------
# Salin file ini menjadi .env.local lalu isi nilainya:
#     cp .env.example .env.local
#
# ATURAN PENTING:
#   * Hanya variabel berawalan NEXT_PUBLIC_ yang boleh terbaca browser.
#   * ANTHROPIC_API_KEY, OCR_SPACE_API_KEY, GOOGLE_VISION_API_KEY, dan
#     SUPABASE_SERVICE_ROLE_KEY TIDAK BOLEH diberi prefix NEXT_PUBLIC_ —
#     semuanya hanya dipakai di server (Route Handler).
#   * .env.local sudah masuk .gitignore, jangan pernah di-commit.
#
# Aplikasi tetap jalan penuh tanpa satu pun variabel di bawah (mode demo:
# data tersimpan di browser). Isi bertahap sesuai fitur yang ingin diaktifkan.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE — autentikasi, database PostgreSQL, dan storage struk
#    Dashboard Supabase > Project Settings > API
#    Kosongkan kalau ingin mencoba aplikasi dalam mode demo lokal.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nama bucket penyimpanan struk (dibuat oleh supabase/schema.sql). Opsional.
NEXT_PUBLIC_SUPABASE_RECEIPT_BUCKET=receipts

# Service role key TIDAK dibutuhkan aplikasi ini. Jangan diisi kecuali Anda
# menambahkan skrip administratif sendiri, dan jangan pernah diekspos ke klien.
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 2. AI — parsing struk, kategorisasi otomatis, insight, dan AI Keuangan
#    Ambil kunci di https://console.anthropic.com/settings/keys
#    Model vision membaca gambar struk langsung, jadi ini saja sudah cukup
#    untuk menjalankan seluruh pipeline OCR + parsing.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Model yang dipakai. Default: claude-sonnet-5 (seimbang antara akurasi & biaya).
AI_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# 3. OCR (opsional) — mesin OCR terpisah sebelum tahap parsing AI
#    Pilih salah satu. Kalau keduanya kosong, gambar dibaca langsung oleh
#    model vision (OCR_PROVIDER=llm).
#
#    ocrspace : https://ocr.space/ocrapi  (ada paket gratis)
#    google   : https://console.cloud.google.com  (Cloud Vision API)
# -----------------------------------------------------------------------------
OCR_PROVIDER=llm

OCR_SPACE_API_KEY=
OCR_SPACE_LANGUAGE=eng

GOOGLE_VISION_API_KEY=
